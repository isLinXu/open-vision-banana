{
  "schema_version": 1,
  "name": "flux-contract-template",
  "description": "Expansion template only. Fill verified adapter/base identity, encoding and prompts before running; not a 6GB laptop recommendation.",
  "device": "cpu",
  "seed": 42,
  "dataset": {"kind": "synthetic", "synthetic_count": 1, "max_samples": 1},
  "models": [{"id": "flux-verified-adapter", "backend": "vision_banana", "weights_variant": "online",
    "base_model_id": "black-forest-labs/FLUX.1-dev",
    "options": {"inference_contract_verified": false,
      "model_time_convention": "native_flux", "num_inference_steps": 20,
      "dtype": "float32", "task_prompts": {}, "encoding_contract": {}}}],
  "sizes": [{"id": "s256", "max_edge": 256, "alignment": 16}, {"id": "s512", "max_edge": 512, "alignment": 16}],
  "tasks": ["semantic", "depth", "normal"],
  "timing": {"warmup": 1, "repeats": 3, "cpu_threads": 1},
  "output": {"visualizations": true, "raw_predictions": true}
}
